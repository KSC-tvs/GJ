# Supabase Project URL (from Supabase Dashboard -> Project Settings -> API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon / Public Key (Safe for browser client with Row Level Security)
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# NOTE: NEVER put the Supabase service_role key into frontend code or .env files!
# The service_role key bypasses RLS and must only be used in private server environments.
